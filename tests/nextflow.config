/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

// keep requests within a GitHub-hosted runner (4 cpus, 16 GB); the local executor refuses
// tasks asking for more, even with -stub-run
process {
    resourceLimits = [
        cpus: 2,
        memory: '8.GB',
        time: '1.h'
    ]
}
